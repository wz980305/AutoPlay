{
  "luci-app-dashplay": {
    "description": "Grant access to DashPlay settings",
    "read": {
      "ubus": {
        "service": [
          "list"
        ],
        "file": [
          "read"
        ]
      },
      "uci": [
        "dashplay"
      ],
      "file": {
        "/var/run/dashplay/network-status.json": [
          "read"
        ],
        "/opt/dashplay/state/update-check.json": [
          "read"
        ],
        "/opt/dashplay/state/update-status.json": [
          "read"
        ],
        "/opt/dashplay/state/own-domain.json": [
          "read"
        ]
      }
    },
    "write": {
      "uci": [
        "dashplay"
      ],
      "ubus": {
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/libexec/dashplay-update": [
          "exec"
        ]
      }
    }
  }
}
