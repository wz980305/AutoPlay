config autoplay 'main'
	option enabled '1'
	# The CarPlay page's HTTPS port. Empty is 18443, or the port an older install saved in
	# state/receiver/config.json (adopted once); changing it takes about a minute and interrupts CarPlay.
	# It must differ from 18080 (the settings page), 80, 443 and 7000.
	option viewer_port ''
	# Seconds without a viewer page before wireless CarPlay ends, so the iPhone stops sending its screen
	# (it runs warm near a box left on); a page opened later invites it again (~7 s). 0: never ends.
	option idle_release '300'
	# The name the Tesla opens, with a Let's Encrypt certificate: a DuckDNS sub-domain and its token
	# (duckdns.org). The name becomes <sub-domain>.duckdns.org, pointed at the box, with a certificate the box
	# obtains and renews itself over the SIM (DNS-01, no open port). Empty: https://autoplay.lan:18443/ with
	# the box's own certificate (whether the Tesla's warning page offers "continue" is unverified).
	option duckdns_domain ''
	option duckdns_token ''
	# A Tencent Cloud (DNSPod) name instead: set dns_provider to 'dnspod' and give a full domain plus the DNSPod
	# API ID and token (console.dnspod.cn → 安全设置 → API Token). The certificate is issued with a DNS-01
	# challenge through acme.sh's dns_dp hook. The A record is managed in the DNSPod console; the box answers
	# the name locally for the Tesla.
	option dns_provider ''
	option own_domain ''
	option dnspod_id ''
	option dnspod_token ''
	# Online update (update.py): check for a new release once a day and show it in LuCI and on the settings page; an
	# update is installed only when someone clicks it. update_mirror: URL prefixes tried after GitHub ('none': GitHub
	# only; empty: the built-in one). Releases are signed, so a mirror cannot alter what is installed.
	option update_check '1'
	option update_mirror ''
# Constants of this box, no option: LAN 100.96.0.1/24 (set once at install, see
# /etc/uci-defaults/90-autoplay-tesla), settings page port 18080, the Tesla's connectivity checks answered
# whenever the service runs, music/calls/Siri over the car's Bluetooth, the first access point (5 GHz first)
# handed to the iPhone, the F50's own Bluetooth helper.
